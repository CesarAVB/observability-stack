        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "labelTypes": true,
              "Line": true,
              "tsNs": true,
              "id": true,
              "TraceID": true,
              "modulo": true,
              "sevn": true,
              "facility": true,
              "host": true,
              "job": true,
              "severity": true,
              "source_ip": true
