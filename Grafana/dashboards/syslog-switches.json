            "indexByName": {
              "Time": 0,
              "switchname": 1,
              "evento": 2,
              "descricao": 3
            },
            "renameByName": {
              "Time": "Hora",
              "switchname": "Switch",
              "evento": "Evento",
              "descricao": "Mensagem"
