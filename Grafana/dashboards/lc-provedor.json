        "codeData": "{}",
        "css": ".onu-panel{box-sizing:border-box;width:100%;height:100%;padding:16px 18px;color:#e6edf3;background:radial-gradient(circle at top left,rgba(56,189,248,.12),transparent 34%),linear-gradient(135deg,#161b22 0%,#101419 100%);border:1px solid rgba(255,255,255,.07);border-radius:14px;font-family:Inter,Arial,sans-serif;overflow:hidden}.onu-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:12px;margin-bottom:12px;border-bottom:1px solid rgba(255,255,255,.08)}.onu-header strong{display:block;color:#fff;font-size:16px;font-weight:800}.onu-header span{display:block;margin-top:4px;color:#9aa4b2;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em}.onu-header div:last-child{color:#38bdf8;font-family:monospace;font-size:15px;font-weight:900}.onu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:9px;height:calc(100% - 58px);overflow:auto}.onu-card{display:flex;flex-direction:column;justify-content:center;min-height:82px;padding:11px 12px;border-radius:10px;background:rgba(255,255,255,.045);border:1px solid rgba(34,197,94,.3);box-shadow:inset 0 1px 0 rgba(255,255,255,.04)}.onu-card.warning{border-color:rgba(250,204,21,.55)}.onu-card.critical{border-color:rgba(239,68,68,.65)}.onu-card span{color:#9aa4b2;font-size:11px;font-weight:800;text-transform:uppercase}.onu-card strong{margin:5px 0 2px;color:#fff;font-family:monospace;font-size:25px;line-height:1}.onu-card small{color:#7d8998;font-size:9px;font-weight:700}.onu-empty{display:grid;place-items:center;height:100%;color:#9aa4b2;font-size:12px;font-weight:700}@media(max-width:600px){.onu-panel{padding:12px}.onu-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.onu-header strong{font-size:14px}}",
        "dynamicData": true,
        "dynamicFieldDisplayValues": true,
        "dynamicHtmlGraphics": true,
        "dynamicProps": true,
        "html": "<div class=\"onu-panel\">\r\n  <div class=\"onu-header\">\r\n    <div>\r\n      <strong>ONUs registradas por PON</strong>\r\n      <span>ZTE-C300-MESQUITA</span>\r\n    </div>\r\n    <div id=\"onu-total\">--</div>\r\n  </div>\r\n\r\n  <div id=\"onu-grid\" class=\"onu-grid\">\r\n    <div class=\"onu-empty\">Aguardando dados...</div>\r\n  </div>\r\n</div>",
        "onInit": "",
        "onInitOnResize": false,
        "onRender": "(function(){\n  var grid = htmlNode.querySelector('#onu-grid');\n  var totalNode = htmlNode.querySelector('#onu-total');\n  var series = (typeof data !== 'undefined' && data && Array.isArray(data.series)) ? data.series : [];\n  grid._ponValues = grid._ponValues || {};\n  series.forEach(function(serie, serieIndex) {\n    var fields = (serie && serie.fields) || [];\n    fields.forEach(function(field) {\n      if (String(field.type || '').toLowerCase() === 'time') return;\n      var values = field.values;\n      var length = values ? (values.length || values.size || 0) : 0;\n      if (!length) return;\n      var raw = String((field.config && field.config.displayName) || field.name || serie.name || '');\n      var value = NaN;\n      for (var i = length - 1; i >= 0; i--) {\n        var candidate = Number(values && typeof values.get === 'function' ? values.get(i) : values[i]);\n        if (Number.isFinite(candidate)) { value = candidate; break; }\n      }\n      if (!Number.isFinite(value)) return;\n      var match = raw.match(/OLT-\\d+/i) || String(serie.name || '').match(/OLT-\\d+/i);\n      var pon = match ? match[0].toUpperCase() : ('OLT-' + (serieIndex + 1));\n      grid._ponValues[pon] = value;\n    });\n  });\n  var pons = Object.keys(grid._ponValues);\n  if (!pons.length) {\n    grid.innerHTML = '<div class=\"onu-empty\">Aguardando dados do Zabbix...</div>';\n    totalNode.textContent = '--';\n    return;\n  }\n  pons.sort(function(a, b) {\n    return (parseInt(a.replace(/\\D+/g, ''), 10) || 0) - (parseInt(b.replace(/\\D+/g, ''), 10) || 0);\n  });\n  var total = 0;\n  var cards = pons.map(function(pon) {\n    var value = grid._ponValues[pon];\n    total += value;\n    return '<div class=\"onu-card ok\"><span>' + pon + '</span><strong>' + value + '</strong><small>ONUs registradas</small></div>';\n  });\n  grid.innerHTML = cards.join('');\n  totalNode.textContent = total + ' ONUs';\n})();",
